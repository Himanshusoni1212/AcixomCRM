@page
@model AcxiomCRM.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in | AcxiomCRM";
    ViewData["Description"] = "Sign in to AcxiomCRM to access your assigned customers, leads, opportunities and follow-ups. Locked accounts recover automatically after 15 minutes.";
}
<h1>Sign in</h1>
<p>Sign in to access your assigned CRM records. Accounts lock for 15 minutes after 5 failed attempts.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" aria-describedby="Email-error" />
        <span asp-validation-for="Input.Email" class="text-danger" id="Email-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">Remember me on this device</label>
    </div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
<p class="mt-3">No account yet? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>.</p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
