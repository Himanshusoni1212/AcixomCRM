@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Create opportunity | AcxiomCRM";
    var customers = ViewBag.Customers as List<AcxiomCRM.Models.Customer> ?? new();
    var sales = ViewBag.SalesUsers as IList<AcxiomCRM.Models.ApplicationUser> ?? new List<AcxiomCRM.Models.ApplicationUser>();
    bool isSales = User.IsInRole("SalesExecutive");
}
<h1>Create opportunity</h1>
<p>Track a potential sale against an existing customer. Figures feed the pipeline report. Required fields are marked.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="OpportunityName" class="form-label"></label>
        <input asp-for="OpportunityName" class="form-control" aria-describedby="OpportunityName-error" />
        <span asp-validation-for="OpportunityName" class="text-danger" id="OpportunityName-error"></span>
    </div>
    <div class="mb-3">
        <label for="CustomerId" class="form-label">Customer</label>
        <select id="CustomerId" name="CustomerId" class="form-select" aria-describedby="CustomerId-error">
            <option value="">Select customer</option>
            @foreach (var c in customers)
            {
                <option value="@c.CustomerId" selected="@(Model.CustomerId == c.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
            }
        </select>
        <span asp-validation-for="CustomerId" class="text-danger" id="CustomerId-error"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" aria-describedby="Amount-error" />
            <span asp-validation-for="Amount" class="text-danger" id="Amount-error"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Probability" class="form-label"></label>
            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" aria-describedby="Probability-error" />
            <span asp-validation-for="Probability" class="text-danger" id="Probability-error"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="ExpectedCloseDate" class="form-label"></label>
        <input asp-for="ExpectedCloseDate" class="form-control" type="date" aria-describedby="ExpectedCloseDate-error" />
        <span asp-validation-for="ExpectedCloseDate" class="text-danger" id="ExpectedCloseDate-error"></span>
    </div>
    @if (isSales)
    {
        <input type="hidden" asp-for="OwnerId" />
        <p>Assigned to you.</p>
    }
    else
    {
        <div class="mb-3">
            <label for="OwnerId" class="form-label">Assigned to (Sales Executive)</label>
            <select id="OwnerId" name="OwnerId" class="form-select">
                <option value="">Select sales executive</option>
                @foreach (var u in sales)
                {
                    <option value="@u.Id" selected="@(Model.OwnerId == u.Id)">@u.Email (@u.FullName)</option>
                }
            </select>
            <span asp-validation-for="OwnerId" class="text-danger"></span>
        </div>
    }
    <div class="mb-3">
        <label asp-for="Source" class="form-label"></label>
        <input asp-for="Source" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save Opportunity</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
