@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Create customer | AcxiomCRM";
}
<h1>Create customer</h1>
<p>Enter customer details to store them in the CRM. Contact details are used only for sales follow-up. Required fields are marked.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="CustomerCode" class="form-label"></label>
        <input asp-for="CustomerCode" class="form-control" aria-describedby="CustomerCode-error" />
        <span asp-validation-for="CustomerCode" class="text-danger" id="CustomerCode-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label"></label>
        <input asp-for="CustomerName" class="form-control" aria-describedby="CustomerName-error" />
        <span asp-validation-for="CustomerName" class="text-danger" id="CustomerName-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" aria-describedby="Email-error" />
        <span asp-validation-for="Email" class="text-danger" id="Email-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" type="tel" aria-describedby="Phone-error" />
        <span asp-validation-for="Phone" class="text-danger" id="Phone-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" aria-describedby="CompanyName-error" />
        <span asp-validation-for="CompanyName" class="text-danger" id="CompanyName-error"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option>Active</option>
            <option>Inactive</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save Customer</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
