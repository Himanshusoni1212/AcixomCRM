@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer details | AcxiomCRM";
}
<h1>Customer details</h1>
@if (TempData["Success"] is string s) { <div class="alert alert-success" role="status">@s</div> }
<dl class="row">
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.CustomerCode</dd>
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.CustomerName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9"><a href="tel:@Model.Phone">@Model.Phone</a></dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address, @Model.City, @Model.State</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
</dl>
<p>
    <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit customer</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>
