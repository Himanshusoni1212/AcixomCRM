@{
    ViewData["Title"] = "Page not found (404) | AcxiomCRM";
    ViewData["Description"] = "The requested AcxiomCRM page was not found. Return to the dashboard or home page to continue working with your CRM records.";
}
<h1>Page not found</h1>
<p>The page requested does not exist or has moved.</p>
<p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Go to Dashboard</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Go to Home</a>
</p>
