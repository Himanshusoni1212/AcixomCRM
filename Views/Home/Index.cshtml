@{
    ViewData["Title"] = "AcxiomCRM: role-based CRM for sales teams";
    ViewData["Description"] = "AcxiomCRM is a role-based CRM that helps sales teams manage customers, leads, opportunities and follow-ups with dashboards, reports and audit logging.";
}
<h1>AcxiomCRM: customer, lead and opportunity tracking</h1>
<p>AcxiomCRM is a role-based web application for sales organisations. It covers the customer lifecycle from lead capture through qualification, follow-up and opportunity management, with dashboards, reports and a complete audit log.</p>
<h2>What it includes</h2>
<ul>
    <li>Customer, lead, opportunity, follow-up and activity records with search and filtering.</li>
    <li>Role-based access for Admin, Manager and Sales Executive users.</li>
    <li>Dashboards with pipeline charts, plus eight exportable reports.</li>
    <li>Secured REST API and append-only audit logging.</li>
</ul>
<p>
    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">Sign in</a>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Open dashboard</a>
</p>
