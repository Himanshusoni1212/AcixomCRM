@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Convert lead | AcxiomCRM";
}
<h1>Convert lead</h1>
@if (TempData["Error"] is string e) { <div class="alert alert-danger" role="alert">@e</div> }
<p>Qualified lead <strong>@Model.LeadName</strong> will become a customer carrying its contact details and expected value. This writes Convert + Create audit entries.</p>
<dl class="row">
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd>
    <dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue</dd>
</dl>
<form asp-action="Convert" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.LeadId" />
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="createOpportunity" name="createOpportunity" value="true" />
        <label class="form-check-label" for="createOpportunity">Also create an opportunity</label>
    </div>
    <div class="mb-3">
        <label class="form-label" for="opportunityName">Opportunity name</label>
        <input class="form-control" id="opportunityName" name="opportunityName" value="@Model.LeadName Opportunity" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" for="amount">Opportunity amount</label>
            <input class="form-control" id="amount" name="amount" type="number" step="0.01" min="0" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" for="probability">Probability (0 to 100)</label>
            <input class="form-control" id="probability" name="probability" type="number" min="0" max="100" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Convert lead</button>
    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-secondary">Cancel</a>
</form>
