@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Create lead | AcxiomCRM";
    var sales = ViewBag.SalesUsers as List<AcxiomCRM.Models.ApplicationUser> ?? new();
    bool isSales = User.IsInRole("SalesExecutive");
}
<h1>Create lead</h1>
<p>Record a prospective customer. Details are used only for qualification and follow-up. Required fields are marked.</p>
<p>New leads always start with status New.</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<form asp-action="Create" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="LeadName" class="form-label"></label>
        <input asp-for="LeadName" class="form-control" aria-describedby="LeadName-error" />
        <span asp-validation-for="LeadName" class="text-danger" id="LeadName-error"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" aria-describedby="Email-error" />
            <span asp-validation-for="Email" class="text-danger" id="Email-error"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" aria-describedby="Phone-error" />
            <span asp-validation-for="Phone" class="text-danger" id="Phone-error"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Source" class="form-label"></label>
            <select asp-for="Source" class="form-select">
                <option>Web</option><option>Referral</option><option>Cold Call</option><option>Other</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" class="form-select">
                <option>Low</option><option>Medium</option><option>High</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ExpectedValue" class="form-label"></label>
            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" aria-describedby="ExpectedValue-error" />
            <span asp-validation-for="ExpectedValue" class="text-danger" id="ExpectedValue-error"></span>
        </div>
    </div>
    @if (isSales)
    {
        <input type="hidden" asp-for="OwnerId" />
        <p>Assigned to you.</p>
    }
    else
    {
        <div class="mb-3">
            <label for="OwnerId" class="form-label">Assigned to (Sales Executive)</label>
            <select id="OwnerId" name="OwnerId" class="form-select" aria-describedby="OwnerId-error">
                <option value="">Select sales executive</option>
                @foreach (var u in sales)
                {
                    <option value="@u.Id" selected="@(Model.OwnerId == u.Id)">@u.Email (@u.FullName)</option>
                }
            </select>
            <span asp-validation-for="OwnerId" class="text-danger" id="OwnerId-error"></span>
        </div>
    }
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save Lead</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
