@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Delete lead | AcxiomCRM";
}
<h1>Delete lead</h1>
<div class="alert alert-warning" role="alert">Are you sure you want to delete <strong>@Model.LeadName</strong>? This cannot be undone.</div>
<form asp-action="Delete" method="post" onsubmit="return confirm('Delete this lead?');">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LeadId" />
    <button type="submit" class="btn btn-danger">Delete lead</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
